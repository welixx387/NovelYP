# База данных. SQLite — для прототипа/разработки, ничего не нужно поднимать отдельно.
# Для продакшена: смените provider на "postgresql" в prisma/schema.prisma и укажите строку подключения сюда.
DATABASE_URL="file:./dev.db"

# Секрет для подписи JWT (сессии в httpOnly cookie). Сгенерируйте случайную строку от 32 символов:
#   openssl rand -base64 32
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"

# Публичный URL приложения (используется для ссылок в письмах и метаданных)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- CryptoBot (Crypto Pay API), см. https://help.crypt.bot/crypto-pay-api ---
# Токен приложения: @CryptoBot -> Crypto Pay -> My Apps -> Create App
CRYPTOBOT_API_TOKEN=""
# "true" -> https://testnet-pay.crypt.bot/api (тестовая сеть, токен из @CryptoTestnetBot)
CRYPTOBOT_TESTNET="true"
# Реальная проверка подписи вебхука не требует отдельного секрета — см. src/lib/cryptobot.ts.
# Переменная оставлена для соответствия ТЗ / на случай будущей ручной проверки.
CRYPTOBOT_WEBHOOK_SECRET=""
NEXT_PUBLIC_BOT_USERNAME="CryptoBot"

# --- Почта для восстановления пароля (опционально) ---
# Если не заполнено — ссылка на сброс пароля просто выводится в консоль сервера (удобно для разработки).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ranobe Reader <no-reply@example.com>"
